# Lead form settings for treeservicebeaverton.net
# These are set in Vercel, not in a file: Project > Settings > Environment Variables (Production + Preview), then redeploy.
# This file is only a reference list. Never commit real values.

# --- 1. Lead storage (required for the /admin/ dashboard) -------------------------------------------
# Added for you when you connect "Upstash for Redis" under Vercel > Storage. Do not type these by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- 2. Dashboard password (required for /admin/) ---------------------------------------------------
# 12 characters or more. Make it long and random. Ten wrong tries lock that address out for 15 minutes.
ADMIN_PASSWORD=

# --- 3. Email alert for every new lead (optional, via resend.com) -----------------------------------
# Verify your sending domain at Resend first. LEAD_TO may be several addresses separated by commas.
RESEND_API_KEY=
LEAD_TO=
LEAD_FROM=Tree Service Beaverton <leads@treeservicebeaverton.net>

# --- 4. Webhook for every new lead (optional: Zapier, Make, a Google Sheets script, a CRM) ----------
LEAD_WEBHOOK_URL=

# --- 5. How long leads are kept before they delete themselves (optional, default 730 days) ----------
LEAD_RETENTION_DAYS=730
